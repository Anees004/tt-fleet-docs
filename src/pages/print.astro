---
import { getCollection } from "astro:content";
import AnnotatedShot from "../components/AnnotatedShot.astro";
import { GROUPS, GUIDE_ORDER, groupLabel, docVersionLine } from "../data/meta";
import { getHighlights } from "../data/highlights";

const guides = (await getCollection("guides"))
  .slice()
  .sort((a, b) => {
    const ai = GUIDE_ORDER.indexOf(a.data.id as (typeof GUIDE_ORDER)[number]);
    const bi = GUIDE_ORDER.indexOf(b.data.id as (typeof GUIDE_ORDER)[number]);
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  });

const byGroup = GROUPS.map((g) => ({
  ...g,
  items: guides.filter((x) => x.data.group === g.id),
})).filter((g) => g.items.length > 0);

const generated = new Date().toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Titan Fleet Operator Help — PDF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --ink: #1c2418;
        --ink-2: #3d4a36;
        --muted: #6b7564;
        --olive: #4a5d3a;
        --olive-soft: #e8efe3;
        --border: #dce3d5;
        --accent: #c45c26;
        --tip: #3a5a7a;
        --warn: #9b3b2e;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: "Source Sans 3", system-ui, sans-serif;
        color: var(--ink);
        background: #fff;
        line-height: 1.5;
        font-size: 11pt;
      }
      h1,
      h2,
      h3 {
        font-family: "Fraunces", Georgia, serif;
        letter-spacing: -0.02em;
        color: var(--ink);
      }
      a {
        color: var(--olive);
      }

      .doc {
        max-width: 820px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      .cover {
        break-after: page;
        padding: 3rem 0 2rem;
        border-bottom: 3px solid var(--olive);
        margin-bottom: 2rem;
      }
      .cover-kicker {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--olive);
        margin: 0 0 0.75rem;
      }
      .cover h1 {
        font-size: 2.4rem;
        margin: 0 0 0.75rem;
        line-height: 1.15;
      }
      .cover p {
        margin: 0 0 0.5rem;
        color: var(--ink-2);
        max-width: 36rem;
      }
      .cover-meta {
        margin-top: 1.5rem;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .print-doc-foot {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        break-inside: avoid;
      }
      .print-doc-foot p {
        margin: 0;
        font-size: 0.8rem;
        color: var(--muted);
      }

      .toc {
        break-after: page;
        margin-bottom: 2rem;
      }
      .toc h2 {
        font-size: 1.5rem;
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--border);
      }
      .toc-group {
        margin: 1.25rem 0 0.5rem;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        color: var(--muted);
      }
      .toc ol {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .toc li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.35rem 0;
        border-bottom: 1px dotted var(--border);
      }
      .toc li a {
        text-decoration: none;
        font-weight: 600;
        color: var(--ink);
      }
      .toc li a:hover {
        color: var(--olive);
      }
      .toc .blurb {
        color: var(--muted);
        font-size: 0.85rem;
        margin-left: auto;
        text-align: right;
        max-width: 45%;
      }

      .guide {
        break-before: page;
        padding-top: 0.5rem;
      }
      .guide-header {
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--olive);
      }
      .badge {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
        background: var(--olive-soft);
        color: var(--olive);
        margin-bottom: 0.35rem;
      }
      .guide-header h2 {
        margin: 0 0 0.35rem;
        font-size: 1.55rem;
      }
      .guide-goal {
        margin: 0;
        color: var(--ink-2);
      }
      .guide-meta {
        font-size: 0.8rem;
        color: var(--muted);
        margin-top: 0.35rem;
      }

      .guide-layout {
        display: grid;
        grid-template-columns: 1fr 240px;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: 1.5rem;
      }
      .steps {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: step;
      }
      .steps li {
        counter-increment: step;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.65rem;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #fafaf7;
      }
      .steps li::before {
        content: counter(step);
        flex-shrink: 0;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        background: var(--olive);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        display: grid;
        place-items: center;
      }

      .point {
        break-inside: avoid;
        margin: 1.25rem 0;
        padding: 1rem 0;
        border-top: 1px solid var(--border);
      }
      .point-grid {
        display: grid;
        grid-template-columns: 1fr 200px;
        gap: 1.25rem;
        align-items: start;
      }
      .point h3 {
        margin: 0 0 0.25rem;
        font-size: 1.1rem;
      }
      .point .tease {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.9rem;
      }
      .point .body {
        margin: 0;
        color: var(--ink-2);
      }
      .callout {
        margin-top: 0.75rem;
        padding: 0.65rem 0.75rem;
        border-left: 3px solid var(--tip);
        background: #e8f0f6;
        font-size: 0.9rem;
        border-radius: 0 8px 8px 0;
      }
      .callout.warn {
        border-left-color: var(--warn);
        background: #f8e8e5;
      }
      .callout strong {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.2rem;
        color: var(--tip);
      }
      .callout.warn strong {
        color: var(--warn);
      }

      .legend {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--muted);
        margin: 0 0 1rem;
      }
      .legend-swatch {
        width: 1rem;
        height: 1rem;
        border: 2.5px solid var(--accent);
        border-radius: 4px;
        box-shadow: 0 0 0 3px rgba(196, 92, 38, 0.2);
      }

      .no-print {
        margin-bottom: 1.5rem;
      }
      .no-print a {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: var(--olive);
        color: #fff;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
      }

      @media print {
        .no-print {
          display: none !important;
        }
        .doc {
          max-width: none;
          padding: 0;
        }
        .guide {
          break-before: page;
        }
        .cover,
        .toc {
          break-after: page;
        }
        a {
          text-decoration: none;
          color: inherit;
        }
        .hl-box {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }

      @media (max-width: 720px) {
        .guide-layout,
        .point-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="doc">
      <p class="no-print">
        <a href="/">← Back to help center</a>
      </p>

      <header class="cover" id="cover">
        <p class="cover-kicker">Titan Fleet</p>
        <h1>Operator help center</h1>
        <p>
          Task-based guides for Sign in, Home, Live Map, bookings, and fleet
          setup. Orange highlights on screenshots mark the control or region
          each topic explains.
        </p>
        <p class="cover-meta">
          {docVersionLine()} · Generated {generated} · Internal operator documentation
        </p>
        <div class="legend" style="margin-top: 1.25rem">
          <span class="legend-swatch" aria-hidden="true"></span>
          Highlighted region on device screenshot
        </div>
      </header>

      <nav class="toc" id="toc" aria-label="Table of contents">
        <h2>Table of contents</h2>
        {
          byGroup.map((g) => (
            <>
              <div class="toc-group">{g.label}</div>
              <ol>
                {g.items.map((item, i) => (
                  <li>
                    <a href={`#guide-${item.data.id}`}>
                      {i + 1}. {item.data.title}
                    </a>
                    <span class="blurb">{item.data.blurb}</span>
                  </li>
                ))}
              </ol>
            </>
          ))
        }
      </nav>

      {
        guides.map((entry) => {
          const d = entry.data;
          const heroHls = getHighlights(d.id, null, d.image);
          return (
            <article class="guide" id={`guide-${d.id}`}>
              <header class="guide-header">
                {d.badge && <span class="badge">{d.badge}</span>}
                <h2>{d.title}</h2>
                <p class="guide-goal">{d.goal}</p>
                <p class="guide-meta">{groupLabel(d.group)} · {d.blurb}</p>
              </header>

              <div class="guide-layout">
                <div>
                  <h3 style="font-size:1rem;margin:0 0 0.65rem;font-family:inherit;">
                    Steps
                  </h3>
                  <ol class="steps">
                    {d.steps.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ol>
                </div>
                {d.image && (
                  <AnnotatedShot
                    src={d.image}
                    alt={`${d.title} screenshot`}
                    highlights={heroHls}
                  />
                )}
              </div>

              {d.points.length > 0 && (
                <section>
                  <h3 style="font-size:1rem;margin:0 0 0.25rem;font-family:inherit;">
                    Explore this screen
                  </h3>
                  {d.points.map((p) => {
                    const shot = p.image || d.image;
                    const hls = getHighlights(d.id, p.id, shot);
                    return (
                      <div class="point" id={`point-${d.id}-${p.id}`}>
                        <div class="point-grid">
                          <div>
                            <h3>{p.title}</h3>
                            <p class="tease">{p.tease}</p>
                            <p class="body">{p.body}</p>
                            {p.tip && (
                              <div class:list={["callout", { warn: p.warn }]}>
                                <strong>{p.warn ? "Watch out" : "Tip"}</strong>
                                {p.tip}
                              </div>
                            )}
                          </div>
                          {shot && (
                            <AnnotatedShot
                              src={shot}
                              alt={`${p.title} screenshot`}
                              highlights={hls}
                              compact
                            />
                          )}
                        </div>
                      </div>
                    );
                  })}
                </section>
              )}
            </article>
          );
        })
      }

      <footer class="print-doc-foot">
        <p>{docVersionLine()}</p>
      </footer>
    </div>
  </body>
</html>

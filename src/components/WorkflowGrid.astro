---
import { WORKFLOWS } from "../data/meta";
import { iconSvg } from "../lib/icons";

interface GuideLite {
  id: string;
  title: string;
  goal: string;
}

interface Props {
  byId: Record<string, GuideLite>;
}

const { byId } = Astro.props;
const chevron = iconSvg("chevron", 14);
---

<p class="section-label">Most-used workflows</p>
<div class="workflow-grid">
  {
    WORKFLOWS.map((w) => {
      const t = byId[w.id];
      if (!t) return null;
      return (
        <a class="workflow-card" href={`/guides/${t.id}/`}>
          <span class="wf-badge">{w.label}</span>
          <h3>{t.title}</h3>
          <p>{t.goal}</p>
          <span class="wf-go">
            Open guide{" "}
            <span set:html={chevron} />
          </span>
        </a>
      );
    })
  }
</div>

---
import HelpLayout from "../layouts/HelpLayout.astro";
import PhoneFrame from "./PhoneFrame.astro";
import { iconSvg } from "../lib/icons";
import { getHighlights } from "../data/highlights";
import { getGuide, getGuides } from "../i18n/guides";
import { localePath, type Locale } from "../i18n/config";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
  task: string;
  point: string;
}

const { locale, task, point } = Astro.props;
const entry = await getGuide(locale, task);
if (!entry) {
  return Astro.redirect(localePath(locale, "/"));
}

const d = entry.data;
const pt = (d.points || []).find((p) => p.id === point);
if (!pt) {
  return Astro.redirect(localePath(locale, `/guides/${d.id}/`));
}

const ui = t(locale);
const relatedGuides = await getGuides(locale);
const relatedById = Object.fromEntries(
  relatedGuides.map((g) => [g.data.id, g.data.title]),
);

const backIcon = iconSvg("chevron", 14);
const paras = pt.body.split(/\n+/).filter(Boolean);
const pointHighlights = getHighlights(d.id, pt.id, pt.image || d.image, locale);
const path = `/guides/${d.id}/${pt.id}/`;
---

<HelpLayout
  title={pt.title}
  activeId={d.id}
  description={pt.body}
  locale={locale}
  path={path}
>
  <div class="detail-view">
    <a class="detail-back" href={localePath(locale, `/guides/${d.id}/`)}>
      <span class="chevron-back" set:html={backIcon} />
      {locale === "es" ? `Volver a ${d.title}` : `Back to ${d.title}`}
    </a>

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localePath(locale, "/")}>{ui.breadcrumbOverview}</a>
      <span class="sep">/</span>
      <a href={localePath(locale, `/guides/${d.id}/`)}>{d.title}</a>
      <span class="sep">/</span>
      <span>{pt.title}</span>
    </nav>

    <article class="detail-panel">
      <h1>{pt.title}</h1>
      <div class="detail-body">
        {paras.map((p) => <p>{p}</p>)}
      </div>

      {
        pt.tip && (
          <div class:list={["callout", { warn: pt.warn }]}>
            <strong>{pt.warn ? ui.watchOut : ui.tip}</strong>
            {pt.tip}
          </div>
        )
      }

      {
        pt.related && pt.related.length > 0 && (
          <div class="related">
            <h2>{locale === "es" ? "Relacionado" : "Related"}</h2>
            <div class="chip-row">
              {pt.related.map((rid) => {
                const title = relatedById[rid];
                if (!title) return null;
                return (
                  <a class="chip" href={localePath(locale, `/guides/${rid}/`)}>
                    {title}
                  </a>
                );
              })}
            </div>
          </div>
        )
      }
    </article>

    {
      pt.image && (
        <div class="detail-shot">
          <PhoneFrame
            src={pt.image}
            alt={`${pt.title} screenshot`}
            highlights={pointHighlights}
          />
        </div>
      )
    }
  </div>
</HelpLayout>

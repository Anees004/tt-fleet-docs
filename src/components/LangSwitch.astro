---
interface Props {
  locale: "en" | "es";
  /** Current path without locale prefix, e.g. /guides/sign-in/ */
  path?: string;
  enLabel: string;
  esLabel: string;
}

const { locale, path = "/", enLabel, esLabel } = Astro.props;

function hrefFor(target: "en" | "es"): string {
  const clean = path.startsWith("/") ? path : `/${path}`;
  if (target === "en") return clean === "" ? "/" : clean;
  if (clean === "/") return "/es/";
  return `/es${clean}`;
}
---

<nav class="lang-switch" aria-label="Language">
  <a
    class:list={["lang-btn", { "is-active": locale === "en" }]}
    href={hrefFor("en")}
    hreflang="en"
    lang="en">{enLabel}</a
  >
  <a
    class:list={["lang-btn", { "is-active": locale === "es" }]}
    href={hrefFor("es")}
    hreflang="es"
    lang="es">{esLabel}</a
  >
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    gap: 0.2rem;
    align-items: center;
    border: 1px solid var(--border, #dce3d5);
    border-radius: 999px;
    padding: 0.12rem;
    background: var(--surface, #fff);
  }
  .lang-btn {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--muted, #6b7564);
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    line-height: 1;
  }
  .lang-btn.is-active {
    background: var(--olive, #4a5d3a);
    color: #fff;
  }
</style>

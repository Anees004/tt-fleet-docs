---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src?: string | null;
  alt?: string;
  highlights?: HighlightBox[] | null;
}

const { src, alt = "", highlights = null } = Astro.props;
const boxes = highlights ?? [];
const labeled = boxes
  .map((box, i) => ({ box, n: i + 1, label: (box.label || "").trim() }))
  .filter((x) => x.label.length > 0);
const multi = boxes.length > 1;
---

<figure class="phone-frame">
  <div class:list={["phone-screen", { "has-highlights": boxes.length > 0 }]}>
    {
      src ? (
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <div class="img-missing">
          <strong>No screenshot</strong>
          This topic is reference-only.
        </div>
      )
    }
    {
      boxes.map((box, i) => {
        const n = i + 1;
        const showNum = labeled.length > 0 && (box.label || "").trim().length > 0;
        return (
          <div
            class:list={["hl-box", { multi }]}
            style={`left:${box.x}%;top:${box.y}%;width:${box.w}%;height:${box.h}%;`}
            aria-hidden="true"
          >
            {showNum && <span class="hl-num">{n}</span>}
          </div>
        );
      })
    }
  </div>
  {
    labeled.length > 0 && (
      <figcaption class="hl-legend">
        <table>
          <tbody>
            {labeled.map(({ n, label }) => (
              <tr>
                <th scope="row">
                  <span class="hl-legend-num">{n}</span>
                </th>
                <td>{label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </figcaption>
    )
  }
</figure>

<style>
  .hl-box {
    position: absolute;
    z-index: 1;
    border: 2.5px solid #8b1a1a;
    border-radius: 8px;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }
  .hl-box.multi {
    background: transparent;
    box-shadow: none;
  }
  .hl-num {
    position: absolute;
    top: 2px;
    left: 2px;
    z-index: 2;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 3px;
    border-radius: 3px;
    background: #8b1a1a;
    color: #fff;
    font-size: 8px;
    font-weight: 700;
    line-height: 1.05rem;
    text-align: center;
    box-shadow: none;
  }
  .hl-legend {
    margin: 0.45rem 0 0;
    width: 100%;
    padding: 0 0.15rem;
  }
  .hl-legend table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.78rem;
    line-height: 1.3;
  }
  .hl-legend th {
    width: 1.5rem;
    padding: 0.2rem 0.3rem 0.2rem 0;
    vertical-align: top;
    font-weight: 700;
  }
  .hl-legend td {
    padding: 0.2rem 0;
    color: var(--ink-2, #3d4a36);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .hl-legend-num {
    display: inline-grid;
    place-items: center;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 3px;
    border-radius: 3px;
    background: #8b1a1a;
    color: #fff;
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
  }
</style>

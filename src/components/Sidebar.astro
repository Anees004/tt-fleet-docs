---
import { GROUPS, DOC_VERSION } from "../data/meta";
import { iconSvg } from "../lib/icons";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";
import { type Locale, localePath, pdfHref, printHref } from "../i18n/config";
import { t, docVersionLineLocalized } from "../i18n/ui";

interface GuideNav {
  id: string;
  group: string;
  title: string;
  blurb: string;
  icon: string;
  searchText: string;
}

interface Props {
  guides: GuideNav[];
  activeId?: string | null;
  locale?: Locale;
  path?: string;
}

const {
  guides,
  activeId = null,
  locale = "en",
  path = "/",
} = Astro.props;
const ui = t(locale);
const versionLine = docVersionLineLocalized(
  locale,
  DOC_VERSION.version,
  DOC_VERSION.revised,
);
const searchIcon = iconSvg("search", 18);
const closeIcon = `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>`;
---

<aside
  class="sidebar"
  id="sidebar"
  aria-label="Help navigation"
  transition:persist={`tf-sidebar-${locale}`}
>
  <div class="sidebar-brand">
    <div class="logo-mark" aria-hidden="true">
      <img src="/images/logo.png" alt="" width="36" height="36" />
    </div>
    <div class="brand-text">
      <strong>Titan Fleet</strong>
      <span>{ui.operatorHelp}</span>
    </div>
    <button
      type="button"
      class="icon-btn sidebar-close"
      id="sidebar-close"
      aria-label={ui.closeMenu}
      set:html={closeIcon}
    />
  </div>

  <div class="sidebar-search">
    <label class="search-field" for="nav-search">
      <Fragment set:html={searchIcon} />
      <input
        type="search"
        id="nav-search"
        placeholder={ui.searchPlaceholder}
        autocomplete="off"
      />
    </label>
  </div>

  <nav class="sidebar-nav" id="sidebar-nav" aria-label="Topics">
    {
      GROUPS.map((g) => {
        const items = guides.filter((t) => t.group === g.id);
        if (!items.length) return null;
        const label = ui.groups[g.id]?.label ?? g.label;
        return (
          <div class="nav-group" data-group={g.id}>
            <div class="nav-group-label">{label}</div>
            {items.map((item) => (
              <a
                class:list={["nav-item", { "is-active": item.id === activeId }]}
                href={localePath(locale, `/guides/${item.id}/`)}
                data-nav={item.id}
                data-search={item.searchText}
              >
                <span class="nav-icon" set:html={iconSvg(item.icon, 18)} />
                <span class="nav-item-text">
                  <strong>{item.title}</strong>
                  <span>{item.blurb}</span>
                </span>
              </a>
            ))}
          </div>
        );
      })
    }
    <p class="nav-empty" id="nav-empty">{ui.noSearchMatch}</p>
  </nav>

  <footer class="sidebar-foot">
    <div class="sidebar-foot-left">
      <a class="text-link" id="nav-home" href={localePath(locale, "/")}>{ui.overview}</a>
      <p class="doc-version" title={versionLine}>{versionLine}</p>
    </div>
    <div class="sidebar-foot-actions">
      <LangSwitch
        locale={locale}
        path={path}
        enLabel={ui.langEn}
        esLabel={ui.langEs}
      />
      <a class="text-link" href={printHref(locale)} target="_blank" rel="noopener"
        >{ui.print}</a
      >
      <a class="text-link" href={pdfHref(locale)} download>{ui.pdf}</a>
      <ThemeToggle />
    </div>
  </footer>
</aside>

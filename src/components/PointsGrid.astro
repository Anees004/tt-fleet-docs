---
import { iconSvg } from "../lib/icons";
import { type Locale, localePath } from "../i18n/config";

interface Point {
  id: string;
  title: string;
  tease: string;
  icon?: string;
}

interface Props {
  taskId: string;
  points: Point[];
  locale?: Locale;
}

const { taskId, points, locale = "en" } = Astro.props;
const chevron = iconSvg("chevron", 16);
---

{
  points.length > 0 && (
    <div class="points-block">
      <h2>{locale === "es" ? "Puntos clave" : "Key points"}</h2>
      <p class="points-intro">
        {locale === "es"
          ? "Toca un punto para una explicación sencilla: qué hace y para qué no sirve."
          : "Tap a point for a plain explanation — what it does, and what it is not for."}
      </p>
      <div class="points-grid">
        {points.map((p) => (
          <a
            class="point-card"
            href={localePath(locale, `/guides/${taskId}/${p.id}/`)}
          >
            <span class="point-icon" set:html={iconSvg(p.icon || "spark", 16)} />
            <span class="point-text">
              <strong>{p.title}</strong>
              <span>{p.tease}</span>
            </span>
            <span class="point-chevron" set:html={chevron} />
          </a>
        ))}
      </div>
    </div>
  )
}

---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  compact?: boolean;
}

const { src, alt = "", highlight = null, compact = false } = Astro.props;

/** Place label outside the box, still on the screenshot (does not grow image size). */
type Side = "above" | "below" | "left" | "right";

function labelSide(h: HighlightBox): Side {
  // Thin control near bottom (e.g. Forgot password) → sit beside, not over Sign in
  if (h.h <= 5 && h.y >= 55) return h.x >= 45 ? "left" : "right";
  // Near top edge → below the box
  if (h.y < 9) return "below";
  // Near bottom edge → above the box
  if (h.y + h.h > 88) return "above";
  // Wide top strip → below
  if (h.y < 14 && h.w > 50) return "below";
  return "above";
}

const side = highlight ? labelSide(highlight) : "above";

let labelStyle = "";
if (highlight) {
  const { x, y, w, h } = highlight;
  if (side === "above") {
    labelStyle = `left:${x}%;top:${y}%;transform:translateY(calc(-100% - 5px));`;
  } else if (side === "below") {
    labelStyle = `left:${x}%;top:${y + h}%;transform:translateY(5px);`;
  } else if (side === "left") {
    labelStyle = `left:${x}%;top:${y + h / 2}%;transform:translate(-100%, -50%) translateX(-5px);`;
  } else {
    labelStyle = `left:${x + w}%;top:${y + h / 2}%;transform:translateY(-50%) translateX(5px);`;
  }
}
---

<figure class:list={["annotated-shot", { compact }]}>
  <div class="annotated-media">
    <img src={src} alt={alt} loading="lazy" />
    {
      highlight && (
        <>
          <div
            class="hl-box"
            style={`left:${highlight.x}%;top:${highlight.y}%;width:${highlight.w}%;height:${highlight.h}%;`}
            aria-hidden="true"
          />
          <span class:list={["hl-label", `hl-${side}`]} style={labelStyle}>
            {highlight.label}
          </span>
        </>
      )
    }
  </div>
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 220px;
  }
  .annotated-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: 0 8px 24px rgba(47, 61, 40, 0.12);
    background: #f4f5f2;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hl-box {
    position: absolute;
    z-index: 1;
    border: 2.5px solid #c45c26;
    border-radius: 10px;
    box-shadow:
      0 0 0 9999px rgba(20, 26, 16, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }
  .hl-label {
    position: absolute;
    z-index: 3;
    background: #c45c26;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.22rem 0.45rem;
    border-radius: 5px;
    white-space: nowrap;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    line-height: 1.2;
  }
</style>

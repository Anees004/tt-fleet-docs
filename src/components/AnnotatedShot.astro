---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  compact?: boolean;
}

const { src, alt = "", highlight = null, compact = false } = Astro.props;
---

<figure class:list={["annotated-shot", { compact }]}>
  {
    highlight && (
      <div class="hl-banner">
        <span class="hl-banner-mark" aria-hidden="true" />
        <strong class="hl-banner-text">{highlight.label}</strong>
      </div>
    )
  }
  <div class="annotated-media">
    <img src={src} alt={alt} loading="lazy" />
    {
      highlight && (
        <div
          class="hl-box"
          style={`left:${highlight.x}%;top:${highlight.y}%;width:${highlight.w}%;height:${highlight.h}%;`}
          aria-hidden="true"
        />
      )
    }
  </div>
</figure>

<style is:global>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 220px;
  }
  .hl-banner {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    margin: 0 0 0.45rem;
    padding: 0.4rem 0.55rem;
    background: #c45c26;
    color: #fff;
    border-radius: 8px;
    box-sizing: border-box;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .hl-banner-mark {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid #fff;
    border-radius: 3px;
    background: transparent;
  }
  .hl-banner-text {
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .annotated-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: 0 8px 24px rgba(47, 61, 40, 0.12);
    background: #f4f5f2;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hl-box {
    position: absolute;
    border: 2.5px solid #c45c26;
    border-radius: 10px;
    box-shadow:
      0 0 0 9999px rgba(20, 26, 16, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
</style>

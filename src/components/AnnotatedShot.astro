---
import type { HighlightBox } from "../data/highlights";

/** Dark red — readable on light screenshots and in PDF. */
const HL = "#8B1A1A";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  highlights?: HighlightBox[] | null;
  compact?: boolean;
  /** Prefer eager for print/PDF so every screenshot is included. */
  eager?: boolean;
  /** Larger phone for PDF guide hero pages that would otherwise look half-blank. */
  hero?: boolean;
}

const {
  src,
  alt = "",
  highlight = null,
  highlights = null,
  compact = false,
  eager = false,
  hero = false,
} = Astro.props;

const boxes: HighlightBox[] =
  highlights && highlights.length > 0
    ? highlights
    : highlight
      ? [highlight]
      : [];

const labeled = boxes
  .map((box, i) => ({ box, n: i + 1, label: (box.label || "").trim() }))
  .filter((x) => x.label.length > 0);

const multi = boxes.length > 1;
---

<figure class:list={["annotated-shot", { compact, hero }]}>
  <div class:list={["annotated-media", { multi }]}>
    <img
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="sync"
    />
    {
      boxes.map((box, i) => {
        const n = i + 1;
        const showNum = labeled.length > 0 && (box.label || "").trim().length > 0;
        return (
          <div
            class:list={["hl-box", { multi }]}
            style={`left:${box.x}%;top:${box.y}%;width:${box.w}%;height:${box.h}%;`}
            aria-hidden="true"
          >
            {showNum && <span class="hl-num">{n}</span>}
          </div>
        );
      })
    }
  </div>
  {
    labeled.length > 0 && (
      <figcaption class="hl-legend">
        <table>
          <tbody>
            {labeled.map(({ n, label }) => (
              <tr>
                <th scope="row">
                  <span class="hl-legend-num">{n}</span>
                </th>
                <td>{label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </figcaption>
    )
  }
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.hero {
    max-width: 220px;
  }
  .annotated-shot.compact {
    max-width: 170px;
  }
  .annotated-media {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    /* No drop-shadow — iOS PDF/Safari paints it as a gray slab behind the shot */
    box-shadow: none;
    background: #fff;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13px;
  }
  .hl-box {
    position: absolute;
    z-index: 1;
    border: 2.5px solid #8b1a1a;
    border-radius: 8px;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }
  .hl-box.multi {
    background: transparent;
    box-shadow: none;
  }
  .hl-num {
    position: absolute;
    top: 2px;
    left: 2px;
    z-index: 2;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 3px;
    border-radius: 3px;
    background: #8b1a1a;
    color: #fff;
    font-size: 8px;
    font-weight: 700;
    line-height: 1.05rem;
    text-align: center;
    box-shadow: none;
  }
  .hl-legend {
    margin: 0.4rem 0 0;
    width: 100%;
  }
  .hl-legend table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.72rem;
    line-height: 1.25;
  }
  .hl-legend th {
    width: 1.4rem;
    padding: 0.15rem 0.25rem 0.15rem 0;
    vertical-align: top;
    font-weight: 700;
  }
  .hl-legend td {
    padding: 0.15rem 0;
    color: #3d4a36;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .hl-legend-num {
    display: inline-grid;
    place-items: center;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 3px;
    border-radius: 3px;
    background: #8b1a1a;
    color: #fff;
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
  }
</style>

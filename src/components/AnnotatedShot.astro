---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  compact?: boolean;
}

const { src, alt = "", highlight = null, compact = false } = Astro.props;
---

<figure class:list={["annotated-shot", { compact }]}>
  <div class="annotated-media">
    <img src={src} alt={alt} loading="lazy" />
    {
      highlight && (
        <div
          class="hl-box"
          style={`left:${highlight.x}%;top:${highlight.y}%;width:${highlight.w}%;height:${highlight.h}%;`}
          aria-hidden="true"
        />
      )
    }
  </div>
  {
    highlight && (
      <p class="hl-caption">
        <span class="hl-caption-mark">Highlighted</span>
        {highlight.label}
      </p>
    )
  }
</figure>

<style is:global>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 220px;
  }
  .annotated-shot .annotated-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: 0 8px 24px rgba(47, 61, 40, 0.12);
    background: #f4f5f2;
  }
  .annotated-shot .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .annotated-shot .hl-box {
    position: absolute;
    border: 2.5px solid #c45c26;
    border-radius: 10px;
    box-shadow:
      0 0 0 9999px rgba(20, 26, 16, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .annotated-shot .hl-caption {
    display: block;
    margin: 0.55rem 0 0;
    padding: 0.45rem 0.65rem;
    background: #c45c26;
    color: #ffffff !important;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
    border-radius: 8px;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .annotated-shot .hl-caption-mark {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.22);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>

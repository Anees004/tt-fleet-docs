---
import type { HighlightBox } from "../data/highlights";

/** Dark red — readable on light screenshots and in PDF. */
const HL = "#8B1A1A";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  highlights?: HighlightBox[] | null;
  compact?: boolean;
  /** Prefer eager for print/PDF so every screenshot is included. */
  eager?: boolean;
  /** Larger phone for PDF guide hero pages that would otherwise look half-blank. */
  hero?: boolean;
}

const {
  src,
  alt = "",
  highlight = null,
  highlights = null,
  compact = false,
  eager = false,
  hero = false,
} = Astro.props;

const boxes: HighlightBox[] =
  highlights && highlights.length > 0
    ? highlights
    : highlight
      ? [highlight]
      : [];

const multi = boxes.length > 1;

type Side = "above" | "below" | "left" | "right" | "inside";

/**
 * Prefer labels outside the highlight so they don’t cover UI.
 * Keep them on the screenshot (above/below) — never spill left/right into page text.
 */
function labelSide(h: HighlightBox): Side {
  const requested = h.side;
  const large = h.h >= 20 && h.w >= 50;
  const thin = h.h <= 12;

  // Thin rows (chips, tabs, toolbars): always sit above/below the box
  if (thin) {
    if (requested === "below") return "below";
    if (h.y < 10) return "below";
    return "above";
  }

  // left/right requests → above/below so labels stay on-shot, not in text column
  if (requested === "left" || requested === "right") {
    return h.y >= 8 ? "above" : "below";
  }
  if (requested === "inside" && large) return "inside";
  if (requested && requested !== "inside") return requested;

  if (h.y + h.h > 88) return "above";
  if (h.y < 10) return "below";
  // Small edge controls: label above/below, not beside (beside spills off-shot)
  if (h.w <= 22 && (h.x + h.w >= 72 || h.x <= 8)) {
    return h.y >= 8 ? "above" : "below";
  }
  if (large) return "inside";
  return "above";
}

/** Clamp left % so a nowrap label stays within the image. */
function clampLeft(x: number): number {
  return Math.max(1, Math.min(x, 58));
}

/** Avoid CSS transforms — they glitch in some iOS PDF viewers. */
function labelInlineStyle(h: HighlightBox, side: Side): string {
  const { x, y, w, h: height } = h;
  const base =
    `position:absolute;z-index:5;background:${HL};color:#fff;` +
    "font-size:9px;font-weight:700;line-height:1.15;letter-spacing:0.02em;" +
    "padding:2px 5px;border-radius:3px;white-space:nowrap;" +
    "box-shadow:none;pointer-events:none;" +
    "max-width:min(42%, 7.5rem);overflow:hidden;text-overflow:ellipsis;";

  if (side === "inside") {
    return base + `left:${clampLeft(x + 1.5)}%;top:${y + 1.2}%;`;
  }
  if (side === "above") {
    // Clearly above the box (~4.2% ≈ label height on phone shots)
    const top = Math.max(0.3, y - 4.2);
    return base + `left:${clampLeft(x)}%;top:${top}%;`;
  }
  if (side === "below") {
    const top = Math.min(96.5, y + height + 0.8);
    return base + `left:${clampLeft(x)}%;top:${top}%;`;
  }
  if (side === "left") {
    return base + `left:${clampLeft(Math.max(1, x - 2))}%;top:${Math.max(0.3, y - 4.2)}%;`;
  }
  return base + `left:${clampLeft(x + w > 55 ? x : x + w + 1)}%;top:${Math.max(0.3, y - 4.2)}%;`;
}
---

<figure class:list={["annotated-shot", { compact, hero }]}>
  <div class:list={["annotated-media", { multi }]}>
    <img
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="sync"
    />
    {
      boxes.map((box) => {
        const side = labelSide(box);
        return (
          <>
            <div
              class:list={["hl-box", { multi }]}
              style={`left:${box.x}%;top:${box.y}%;width:${box.w}%;height:${box.h}%;`}
              aria-hidden="true"
            />
            {
              box.label ? (
                <span class="hl-label" style={labelInlineStyle(box, side)}>
                  {box.label}
                </span>
              ) : null
            }
          </>
        );
      })
    }
  </div>
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.hero {
    max-width: 220px;
  }
  .annotated-shot.compact {
    max-width: 170px;
  }
  .annotated-media {
    position: relative;
    border-radius: 14px;
    /* Clip labels so they never spill into adjacent page text */
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: none;
    background: #fff;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13px;
  }
  .hl-box {
    position: absolute;
    z-index: 1;
    border: 2.5px solid #8b1a1a;
    border-radius: 8px;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }
  .hl-box.multi {
    background: transparent;
    box-shadow: none;
  }
</style>

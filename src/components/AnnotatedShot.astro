---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  compact?: boolean;
}

const { src, alt = "", highlight = null, compact = false } = Astro.props;
---

<figure class:list={["annotated-shot", { compact }]}>
  <div class="annotated-media">
    <img src={src} alt={alt} loading="lazy" />
    {
      highlight && (
        <div
          class="hl-box"
          style={`left:${highlight.x}%;top:${highlight.y}%;width:${highlight.w}%;height:${highlight.h}%;`}
          aria-hidden="true"
        />
      )
    }
  </div>
  {
    highlight && (
      <figcaption class="hl-caption">
        <span class="hl-swatch" aria-hidden="true" />
        <span class="hl-caption-text">{highlight.label}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 220px;
  }
  .annotated-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: 0 8px 24px rgba(47, 61, 40, 0.12);
    background: #f4f5f2;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hl-box {
    position: absolute;
    border: 2.5px solid #c45c26;
    border-radius: 10px;
    box-shadow:
      0 0 0 9999px rgba(20, 26, 16, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }
  .hl-caption {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #c45c26;
    line-height: 1.3;
  }
  .hl-swatch {
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.1rem;
    border: 2.5px solid #c45c26;
    border-radius: 4px;
    box-shadow: 0 0 0 2px rgba(196, 92, 38, 0.2);
    background: rgba(196, 92, 38, 0.12);
  }
  .hl-caption-text {
    min-width: 0;
  }
</style>

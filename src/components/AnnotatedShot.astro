---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  compact?: boolean;
}

const { src, alt = "", highlight = null, compact = false } = Astro.props;
const labelBelow = highlight ? highlight.y < 10 : false;
const labelStyle = highlight
  ? labelBelow
    ? `left:${highlight.x}%;top:${highlight.y + highlight.h}%;`
    : `left:${highlight.x}%;top:${highlight.y}%;`
  : "";
---

<figure class:list={["annotated-shot", { compact }]}>
  <div class="annotated-frame">
    <div class="annotated-media">
      <img src={src} alt={alt} loading="lazy" />
      {
        highlight && (
          <div
            class="hl-box"
            style={`left:${highlight.x}%;top:${highlight.y}%;width:${highlight.w}%;height:${highlight.h}%;`}
          />
        )
      }
    </div>
    {
      highlight && (
        <span
          class:list={["hl-label", { "hl-label-below": labelBelow }]}
          style={labelStyle}
        >
          {highlight.label}
        </span>
      )
    }
  </div>
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 220px;
  }
  .annotated-frame {
    position: relative;
    overflow: visible;
  }
  .annotated-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: 0 8px 24px rgba(47, 61, 40, 0.12);
    background: #f4f5f2;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hl-box {
    position: absolute;
    border: 2.5px solid #c45c26;
    border-radius: 10px;
    box-shadow:
      0 0 0 9999px rgba(20, 26, 16, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }
  .hl-label {
    position: absolute;
    z-index: 2;
    transform: translateY(calc(-100% - 6px));
    background: #c45c26;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.15rem 0.4rem;
    border-radius: 5px;
    white-space: nowrap;
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
  .hl-label-below {
    transform: translateY(6px);
  }
</style>

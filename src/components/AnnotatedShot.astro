---
import type { HighlightBox } from "../data/highlights";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  compact?: boolean;
}

const { src, alt = "", highlight = null, compact = false } = Astro.props;

type Side = "above" | "below" | "left" | "right";

function labelSide(h: HighlightBox): Side {
  // Tall menus near the top (theme / language) → sit to the side
  if (h.y < 12 && h.h >= 10) return h.x < 40 ? "right" : "left";
  // Thin control near bottom → beside (avoid Sign in / other buttons)
  if (h.h <= 5 && h.y >= 55) return h.x >= 45 ? "left" : "right";
  if (h.y < 9) return "below";
  if (h.y + h.h > 88) return "above";
  if (h.y < 14 && h.w > 50) return "below";
  return "above";
}

function labelInlineStyle(h: HighlightBox, side: Side): string {
  const { x, y, w, height } = { ...h, height: h.h };
  const base =
    "position:absolute;z-index:5;background:#c45c26;color:#fff;" +
    "font-size:11px;font-weight:700;line-height:1.2;letter-spacing:0.02em;" +
    "padding:3px 7px;border-radius:5px;white-space:nowrap;" +
    "box-shadow:0 2px 6px rgba(0,0,0,0.35);pointer-events:none;" +
    "max-width:48%;overflow:hidden;text-overflow:ellipsis;";

  if (side === "above") {
    return (
      base +
      `left:${x}%;top:${y}%;transform:translateY(calc(-100% - 6px));`
    );
  }
  if (side === "below") {
    return base + `left:${x}%;top:${y + height}%;transform:translateY(6px);`;
  }
  if (side === "left") {
    return (
      base +
      `left:${x}%;top:${y + height / 2}%;transform:translate(-100%,-50%) translateX(-6px);`
    );
  }
  // right
  return (
    base +
    `left:${x + w}%;top:${y + height / 2}%;transform:translateY(-50%) translateX(6px);`
  );
}

const side = highlight ? labelSide(highlight) : "above";
const labelStyle = highlight ? labelInlineStyle(highlight, side) : "";
---

<figure class:list={["annotated-shot", { compact }]}>
  <div class="annotated-media">
    <img src={src} alt={alt} loading="lazy" />
    {
      highlight && (
        <>
          <div
            class="hl-box"
            style={`left:${highlight.x}%;top:${highlight.y}%;width:${highlight.w}%;height:${highlight.h}%;`}
            aria-hidden="true"
          />
          <span class="hl-label" style={labelStyle}>{highlight.label}</span>
        </>
      )
    }
  </div>
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 220px;
  }
  .annotated-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #c0cbb5;
    box-shadow: 0 8px 24px rgba(47, 61, 40, 0.12);
    background: #f4f5f2;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hl-box {
    position: absolute;
    z-index: 1;
    border: 2.5px solid #c45c26;
    border-radius: 10px;
    background: transparent;
    box-shadow:
      0 0 0 9999px rgba(20, 26, 16, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }
</style>

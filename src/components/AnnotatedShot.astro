---
import type { HighlightBox } from "../data/highlights";

/** Dark red — readable on light screenshots and in PDF. */
const HL = "#8B1A1A";
const HL_SOFT = "rgba(139, 26, 26, 0.08)";

interface Props {
  src: string;
  alt?: string;
  highlight?: HighlightBox | null;
  highlights?: HighlightBox[] | null;
  compact?: boolean;
  /** Prefer eager for print/PDF so every screenshot is included. */
  eager?: boolean;
  /** Larger phone for PDF guide hero pages that would otherwise look half-blank. */
  hero?: boolean;
}

const {
  src,
  alt = "",
  highlight = null,
  highlights = null,
  compact = false,
  eager = false,
  hero = false,
} = Astro.props;

const boxes: HighlightBox[] =
  highlights && highlights.length > 0
    ? highlights
    : highlight
      ? [highlight]
      : [];

const multi = boxes.length > 1;

type Side = "above" | "below" | "left" | "right" | "inside";

/** Prefer outside labels; keep inside only for large regions or explicit large boxes. */
function labelSide(h: HighlightBox): Side {
  const requested = h.side;
  const large = h.h >= 20 && h.w >= 50;

  if (requested === "inside" && large) return "inside";
  if (requested && requested !== "inside") return requested;

  // Outside heuristics (never default multi → inside)
  if (h.y + h.h > 88) return "above";
  if (h.y < 10) return h.x + h.w > 60 ? "left" : "below";
  if (h.x + h.w >= 72) return "left";
  if (h.x <= 8) return "right";
  if (h.h <= 6) return h.y < 45 ? "below" : "above";
  if (large) return "inside";
  return "above";
}

/** Avoid CSS transforms where possible — they glitch in some iOS PDF viewers. */
function labelInlineStyle(h: HighlightBox, side: Side, multiMode: boolean): string {
  const { x, y, w, h: height } = h;
  const shadow = multiMode
    ? "box-shadow:none;"
    : "box-shadow:0 1px 2px rgba(0,0,0,0.18);";
  const base =
    `position:absolute;z-index:5;background:${HL};color:#fff;` +
    "font-size:9px;font-weight:700;line-height:1.15;letter-spacing:0.02em;" +
    "padding:2px 5px;border-radius:3px;white-space:nowrap;" +
    shadow +
    "pointer-events:none;" +
    "max-width:40%;overflow:hidden;text-overflow:ellipsis;";

  if (side === "inside") {
    return base + `left:${x + 1.5}%;top:${y + 1.2}%;`;
  }
  if (side === "above") {
    // ~18px above box top — no transform
    return base + `left:${x}%;top:calc(${y}% - 18px);`;
  }
  if (side === "below") {
    return base + `left:${x}%;top:calc(${y + height}% + 4px);`;
  }
  if (side === "left") {
    return (
      base +
      `right:calc(${100 - x}% + 4px);left:auto;top:calc(${y}% + ${height / 2}% - 8px);`
    );
  }
  return (
    base + `left:calc(${x + w}% + 4px);top:calc(${y}% + ${height / 2}% - 8px);`
  );
}
---

<figure class:list={["annotated-shot", { compact, hero }]}>
  <div class:list={["annotated-media", { multi }]}>
    <img
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="sync"
    />
    {
      boxes.map((box) => {
        const side = labelSide(box);
        return (
          <>
            <div
              class:list={["hl-box", { multi }]}
              style={`left:${box.x}%;top:${box.y}%;width:${box.w}%;height:${box.h}%;`}
              aria-hidden="true"
            />
            {
              box.label ? (
                <span class="hl-label" style={labelInlineStyle(box, side, multi)}>
                  {box.label}
                </span>
              ) : null
            }
          </>
        );
      })
    }
  </div>
</figure>

<style>
  .annotated-shot {
    margin: 0;
    max-width: 280px;
  }
  .annotated-shot.compact {
    max-width: 240px;
  }
  .annotated-shot.hero {
    max-width: 340px;
  }
  .annotated-media {
    position: relative;
    border-radius: 14px;
    overflow: visible;
    border: 1px solid #c0cbb5;
    box-shadow: 0 6px 18px rgba(47, 61, 40, 0.1);
    background: #f4f5f2;
  }
  .annotated-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13px;
  }
  .hl-box {
    position: absolute;
    z-index: 1;
    border: 2.5px solid #8b1a1a;
    border-radius: 8px;
    background: rgba(139, 26, 26, 0.07);
    box-shadow: none;
    pointer-events: none;
  }
  .hl-box.multi {
    background: rgba(139, 26, 26, 0.06);
    box-shadow: none;
  }
</style>

---
import { ClientRouter } from "astro:transitions";
import Sidebar from "../components/Sidebar.astro";
import { DOC_VERSION } from "../data/meta";
import { navGuides, getGuides } from "../i18n/guides";
import { type Locale, DEFAULT_LOCALE } from "../i18n/config";
import { t, docVersionLineLocalized } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title?: string;
  activeId?: string | null;
  description?: string;
  locale?: Locale;
  /** Path without locale prefix for language switcher */
  path?: string;
}

const {
  title,
  activeId = null,
  description,
  locale = DEFAULT_LOCALE,
  path = "/",
} = Astro.props;

const ui = t(locale);
const pageTitle = title ?? ui.helpCenter;
const pageDesc =
  description ??
  (locale === "es"
    ? "Centro de ayuda del operador Titan Fleet — guías por tareas para Inicio, Mapa en vivo, reservas y configuración."
    : "Titan Fleet operator help center — task-based guides for Home, Live Map, bookings, and fleet setup.");

const guides = navGuides(await getGuides(locale));
const versionLine = docVersionLineLocalized(
  locale,
  DOC_VERSION.version,
  DOC_VERSION.revised,
);

const menuIcon = `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>`;
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <title
      >{
        pageTitle === ui.helpCenter
          ? ui.siteTitle
          : `${pageTitle} · ${ui.siteTitle}`
      }</title
    >
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" hreflang="en" href={path === "/" ? "/" : path} />
    <link
      rel="alternate"
      hreflang="es"
      href={path === "/" ? "/es/" : `/es${path}`}
    />
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("tf-theme");
          document.documentElement.setAttribute(
            "data-theme",
            s === "dark" ? "dark" : "light",
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="app-shell">
      <button
        type="button"
        class="sidebar-backdrop"
        id="sidebar-backdrop"
        hidden
        aria-label={ui.closeMenu}
      ></button>

      <Sidebar
        guides={guides}
        activeId={activeId}
        locale={locale}
        path={path}
      />

      <div class="main-wrap">
        <header class="topbar">
          <button
            type="button"
            class="icon-btn menu-toggle"
            id="menu-toggle"
            aria-label={ui.openMenu}
            aria-controls="sidebar"
            aria-expanded="false"
            set:html={menuIcon}
          />
          <div class="topbar-title" id="topbar-title">{pageTitle}</div>
        </header>

        <main class="main" id="main" tabindex="-1" transition:animate="fade">
          <slot />
          <footer class="site-doc-foot">
            <p>{versionLine}</p>
          </footer>
        </main>
      </div>
    </div>

    <script>
      import "../scripts/nav-search";
    </script>
  </body>
</html>
